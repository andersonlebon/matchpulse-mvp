VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google auth provider setup lives in Google Cloud and Supabase Dashboard.
# See docs/google-auth.md for the required Client ID, Client Secret, and redirect URLs.
# Brevo SMTP setup for Supabase Auth emails lives in Brevo, Vercel DNS, and Supabase Dashboard.
# See docs/brevo-smtp.md. Do not add SMTP keys to VITE_ environment variables.

# Server-only (set in Vercel — never VITE_ prefix)
API_FOOTBALL_KEY=your-api-football-key
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
