# Client (Vite — safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only — set in Vercel Project → Settings → Environment Variables
# Never use VITE_ prefix for these keys

# Live World Cup 2026 data (API-Football / api-sports.io)
# Sign up: https://dashboard.api-football.com/register
# Free tier: 100 requests/day
API_FOOTBALL_KEY=your-api-football-key

# Pulse AI (OpenRouter — server proxy only, never exposed to browser)
# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
